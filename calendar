    function softTap(el){
      if (!el) return;
      el.classList.remove('tap-pop');
      void el.offsetWidth;
      el.classList.add('tap-pop');
      if (navigator.vibrate) navigator.vibrate(8);
    }

    function populateLegendAndFilter() {
      Object.keys(categoryMeta).forEach(key => {
        const meta = categoryMeta[key];
        const item = document.createElement('div');
        item.className = 'legend-item';
        item.innerHTML = `<span class="dot" style="background:${meta.color}"></span>${meta.label}`;
        legend.appendChild(item);

        const option = document.createElement('option');
        option.value = key;
        option.textContent = meta.label;
        categoryFilter.appendChild(option);
      });
    }

    function normalizeArabic(text = '') {
      return String(text)
        .normalize('NFKD')
        .replace(/[\u064B-\u065F\u0670]/g, '')
        .replace(/[أإآٱ]/g, 'ا')
        .replace(/ى/g, 'ي')
        .replace(/ة/g, 'ه')
        .replace(/ؤ/g, 'و')
        .replace(/ئ/g, 'ي')
        .replace(/ـ/g, '')
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();
    }

    function matchesFilters(event) {
      const q = normalizeArabic(searchInput.value);
      const cat = categoryFilter.value;
      const text = normalizeArabic(`${event.title} ${categoryMeta[event.category].label}`);
      const queryOk = !q || text.includes(q);
      const catOk = cat === 'all' || event.category === cat;
      return queryOk && catOk;
    }

    function getGlobalSearchResults() {
      const q = normalizeArabic(searchInput.value);
      const cat = categoryFilter.value;
      if (!q) return [];

      const results = [];
      months.forEach((month, monthIndex) => {
        month.events.forEach(event => {
          const categoryOk = cat === 'all' || event.category === cat;
          const haystack = normalizeArabic(
            `${event.title} ${categoryMeta[event.category].label} ${month.title}`
          );
          if (categoryOk && haystack.includes(q)) {
            results.push({ month, monthIndex, event });
          }
        });
      });

      return results.sort((a, b) =>
        a.monthIndex - b.monthIndex || a.event.day - b.event.day
      );
    }

    function jumpToFirstSearchResult() {
      const q = normalizeArabic(searchInput.value);
      if (q.length < 2) {
        state.searchHit = null;
        render();
        return;
      }

      const results = getGlobalSearchResults();
      if (!results.length) {
        state.searchHit = null;
        render();
        return;
      }

      const first = results[0];
      state.activeMonthIndex = first.monthIndex;
      state.view = 'month';
      state.searchHit = { monthIndex:first.monthIndex, day:first.event.day };
      render();

      requestAnimationFrame(() => {
        const hit = document.querySelector(
          `.day[data-month-index="${first.monthIndex}"][data-day="${first.event.day}"]`
        );
        if (hit) hit.scrollIntoView({ behavior:'smooth', block:'center', inline:'center' });
      });
    }

    function buildMonthNav() {
      monthNav.innerHTML = '';
      months.forEach((month, index) => {
        const btn = document.createElement('button');
        btn.className = 'month-chip' + (index === state.activeMonthIndex ? ' active' : '');
        btn.textContent = month.title;
        btn.addEventListener('click', () => {
          state.activeMonthIndex = index;
          state.view = 'month';
          softTap(btn);
          render();
        });
        monthNav.appendChild(btn);
      });
    }

    function renderCalendar(month) {
      calendarGrid.innerHTML = '';
      monthTitle.textContent = month.title;
      seasonLabel.textContent = month.season;

      weekDays.forEach(name => {
        const head = document.createElement('div');
        head.className = 'weekday';
        head.textContent = name;
        calendarGrid.appendChild(head);
      });

      for (let i = 0; i < month.startOffset; i++) {
        const empty = document.createElement('div');
        empty.className = 'day empty';
        calendarGrid.appendChild(empty);
      }

      for (let day = 1; day <= month.days; day++) {
        const original = month.events.filter(e => e.day === day);
        const filtered = original.filter(matchesFilters);
        const cell = document.createElement('div');
        cell.className = 'day' + (original.length ? ' has-events' : '') + (original.length && !filtered.length ? ' dimmed' : '');
        cell.dataset.day = day;
        cell.dataset.monthIndex = state.activeMonthIndex;
        if (state.searchHit &&
            state.searchHit.monthIndex === state.activeMonthIndex &&
            state.searchHit.day === day) {
          cell.classList.add('search-hit');
        }

        const top = document.createElement('div');
        top.className = 'day-top';

        const number = document.createElement('div');
        number.className = 'day-number';
        number.textContent = day;
        if (filtered.length) {
          number.style.background = categoryMeta[filtered[0].category].color;
          number.style.color = '#fff';
        }

        const count = document.createElement('div');
        count.className = 'count';
        count.textContent = filtered.length ? (filtered.length + ' حدث') : (original.length ? 'مخفي' : '');

        top.appendChild(number);
        top.appendChild(count);
        cell.appendChild(top);

        if (filtered.length) {
          const text = document.createElement('div');
          text.className = 'day-text';
          text.textContent = filtered.map(e => e.title).join(' • ');
          cell.appendChild(text);

          const markers = document.createElement('div');
          markers.className = 'marker-row';
          [...new Set(filtered.map(e => e.category))].forEach(cat => {
            const marker = document.createElement('span');
            marker.className = 'marker';
            marker.style.background = categoryMeta[cat].color;
            markers.appendChild(marker);
          });
          cell.appendChild(markers);
        }

        if (original.length) {
          cell.addEventListener('click', () => {
            softTap(cell);
            openModal(month.title, day, filtered.length ? filtered : original, !filtered.length);
          });
        }

        calendarGrid.appendChild(cell);
      }
    }

    function renderEvents(month) {
      const isSearching = normalizeArabic(searchInput.value).length >= 2;
      eventList.innerHTML = '';

      if (isSearching) {
        const results = getGlobalSearchResults();
        eventsCount.textContent = results.length + ' نتيجة في السنة';

        if (!results.length) {
          eventList.innerHTML = '<div class="empty-state">لا توجد نتيجة مطابقة في رزنامة السنة.</div>';
          return;
