          const card = document.createElement('div');
          card.className = 'event-card';
          card.innerHTML = `<div class="event-top"><span class="tag"><span class="dot" style="background:${meta.color}"></span>${meta.label}</span><span class="search-result-date">${event.day} ${resultMonth.title}</span></div><p class="event-title">${event.title}</p>`;
          card.addEventListener('click', () => {
            state.activeMonthIndex = monthIndex;
            state.view = 'month';
            state.searchHit = { monthIndex, day:event.day };
            render();
            requestAnimationFrame(() => {
              const hit = document.querySelector(`.day[data-month-index="${monthIndex}"][data-day="${event.day}"]`);
              if (hit) hit.scrollIntoView({behavior:'smooth', block:'center', inline:'center'});
            });
          });
          eventList.appendChild(card);
        });
        return;
      }

      const items = month.events.filter(matchesFilters).sort((a, b) => a.day - b.day);
      eventsCount.textContent = items.length + ' حدث';

      if (!items.length) {
        eventList.innerHTML = '<div class="empty-state">لا توجد أحداث مطابقة في هذا الشهر.</div>';
        return;
      }

      items.forEach(event => {
        const meta = categoryMeta[event.category];
        const card = document.createElement('div');
        card.className = 'event-card';
        card.innerHTML = `<div class="event-top"><span class="tag"><span class="dot" style="background:${meta.color}"></span>${meta.label}</span><span>${event.day} ${month.title.split(' ')[0]}</span></div><p class="event-title">${event.title}</p>`;
        card.addEventListener('click', () => {
          softTap(card);
          const sameDay = month.events.filter(e => e.day === event.day && matchesFilters(e));
          openModal(month.title, event.day, sameDay, false);
        });
        eventList.appendChild(card);
      });
    }

    function renderSummary(month) {
      const counts = { school:0, meeting:0, holiday:0, global:0, islamic:0, grades:0, review:0, exam:0 };
      month.events.filter(matchesFilters).forEach(e => { counts[e.category]++; });
      summaryGrid.innerHTML = '';
