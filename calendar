<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>رزنامة الجنان 2026–2027</title>
  
  <style>
    :root{
      --bg:#f4f7f6;
      --surface:rgba(255,255,255,.72);
      --surface-strong:rgba(255,255,255,.94);
      --text:#18231f;
      --muted:#738078;
      --line:rgba(29,50,42,.09);

      --green:#4f7568;
      --green-2:#6c9587;
      --green-dark:#35584d;
      --green-soft:#eef5f2;

      --school:#c98655;
      --meeting:#718fa9;
      --holiday:#b8986e;
      --global:#93a869;
      --islamic:#6f9d89;
      --grades:#8c82b7;
      --review:#70a6b8;
      --exam:#cc6f78;

      --shadow-lg:0 24px 70px rgba(31,55,46,.10);
      --shadow-md:0 14px 34px rgba(31,55,46,.08);
      --shadow-sm:0 7px 18px rgba(31,55,46,.055);

      --r-xl:30px;
      --r-lg:24px;
      --r-md:18px;
      --r-sm:14px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      min-height:100vh;
      color:var(--text);
      font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Segoe UI",Tahoma,Arial,sans-serif;
      -webkit-font-smoothing:antialiased;
      text-rendering:optimizeLegibility;
      background:
        radial-gradient(circle at 15% 8%, rgba(92,137,121,.16), transparent 28%),
        radial-gradient(circle at 88% 18%, rgba(116,148,136,.10), transparent 22%),
        linear-gradient(180deg,#fbfcfc 0%,#f2f6f4 48%,#edf2f0 100%);
      background-attachment:fixed;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      background:
        linear-gradient(rgba(255,255,255,.18),rgba(255,255,255,0)),
        radial-gradient(circle at 50% 100%,rgba(255,255,255,.72),transparent 46%);
      z-index:-1;
    }

    .container{
      width:min(1180px,calc(100% - 20px));
      margin:12px auto 28px;
      padding-bottom:110px;
    }

    .glass{
      background:var(--surface);
      border:1px solid rgba(255,255,255,.72);
      box-shadow:var(--shadow-md);
      backdrop-filter:blur(24px) saturate(140%);
      -webkit-backdrop-filter:blur(24px) saturate(140%);
    }

    .hero{
      position:relative;
      overflow:hidden;
      border-radius:34px;
      padding:24px;
      background:
        linear-gradient(135deg,rgba(255,255,255,.92),rgba(255,255,255,.70)),
        linear-gradient(135deg,rgba(83,122,108,.13),rgba(255,255,255,0));
      animation:fadeUp .55s cubic-bezier(.2,.8,.2,1);
    }

    .hero::before,
    .hero::after{
      content:"";
      position:absolute;
      border-radius:999px;
      filter:blur(2px);
      pointer-events:none;
    }

    .hero::before{
      width:220px;height:220px;
      left:-80px;top:-110px;
      background:radial-gradient(circle,rgba(83,122,108,.16),rgba(83,122,108,0) 70%);
    }

    .hero::after{
      width:250px;height:250px;
      right:-120px;bottom:-150px;
      background:radial-gradient(circle,rgba(115,155,141,.12),rgba(115,155,141,0) 72%);
    }

    @keyframes fadeUp{
      from{opacity:0;transform:translateY(14px) scale(.99)}
      to{opacity:1;transform:translateY(0) scale(1)}
    }

    @keyframes monthIn{
      from{opacity:.45;transform:translateY(10px)}
      to{opacity:1;transform:translateY(0)}
    }

    @keyframes tapPop{
      0%{transform:scale(1)}
      50%{transform:scale(.975)}
      100%{transform:scale(1)}
    }

    .month-animate{animation:monthIn .30s cubic-bezier(.2,.8,.2,1)}
    .tap-pop{animation:tapPop .2s ease}

    .top-row{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:16px;
      position:relative;
      z-index:1;
    }

    .pills{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      margin-bottom:12px;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      min-height:32px;
      padding:7px 12px;
      border-radius:999px;
      color:var(--green-dark);
      background:rgba(83,122,108,.09);
      border:1px solid rgba(83,122,108,.10);
      font-size:.78rem;
      font-weight:750;
      letter-spacing:.01em;
    }

    h1{
      margin:0;
      color:var(--green-dark);
      font-size:clamp(1.55rem,2.6vw,2.2rem);
      line-height:1.1;
      letter-spacing:-.045em;
      font-weight:850;
    }

    .hero p{
      margin:7px 0 0;
      color:var(--muted);
      font-size:.94rem;
      line-height:1.7;
      font-weight:600;
    }

    .hero img{
      width:58px !important;
      height:58px !important;
      padding:7px !important;
      border-radius:20px !important;
      background:rgba(255,255,255,.9) !important;
      box-shadow:0 12px 30px rgba(35,59,51,.12) !important;
      border:1px solid rgba(255,255,255,.9);
      position:relative;
      z-index:2;
    }

    .legend-box{
      position:relative;
      z-index:1;
      margin-top:18px;
      padding:16px;
      border-radius:24px;
      background:rgba(255,255,255,.66);
      border:1px solid rgba(29,50,42,.07);
    }

    .legend-box h2{
      margin:0 0 12px;
      color:var(--green-dark);
      font-size:.95rem;
      font-weight:800;
    }

    .legend{
      display:flex;
      flex-wrap:wrap;
      gap:9px;
    }

    .legend-item{
      display:flex;
      align-items:center;
      gap:8px;
      min-height:34px;
      padding:7px 10px;
      border-radius:999px;
      background:rgba(255,255,255,.74);
      border:1px solid rgba(29,50,42,.06);
      font-size:.76rem;
      color:#3c4a44;
      font-weight:650;
    }

    .dot,.marker{border-radius:50%}
    .dot{width:9px;height:9px;flex:0 0 9px}

    .toolbar{
      position:sticky;
      top:10px;
      z-index:35;
      margin:12px 0;
      padding:10px;
      display:grid;
      grid-template-columns:1fr;
      gap:9px;
      border-radius:24px;
      background:rgba(248,251,250,.78);
      box-shadow:0 14px 34px rgba(31,55,46,.08);
    }

    input,select,textarea,button{font:inherit}

    .field,.select,.textarea{
      width:100%;
      color:var(--text);
      background:rgba(255,255,255,.88);
      border:1px solid rgba(29,50,42,.08);
      outline:none;
      border-radius:17px;
      transition:.2s ease;
      box-shadow:inset 0 1px 0 rgba(255,255,255,.7);
    }

    .field,.select{padding:12px 14px}
    .textarea{min-height:128px;padding:14px;resize:vertical;line-height:1.8}

    .field:focus,.select:focus,.textarea:focus{
      border-color:rgba(83,122,108,.28);
      box-shadow:0 0 0 4px rgba(83,122,108,.075);
      background:#fff;
    }

    .switch-wrap,.action-wrap{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    .switch-wrap{
      padding:4px;
      border-radius:17px;
      background:rgba(255,255,255,.74);
      border:1px solid rgba(29,50,42,.07);
    }

    button{
      border:0;
      cursor:pointer;
      border-radius:15px;
      padding:10px 14px;
      font-weight:760;
      transition:transform .18s ease,box-shadow .18s ease,background .18s ease,color .18s ease;
    }

    button:active{transform:scale(.98)}

    .switch-btn,.nav-btn{
      flex:1;
      background:transparent;
      color:var(--muted);
    }

    .switch-btn.active,.btn-primary,.nav-btn.active{
      color:#fff;
      background:linear-gradient(135deg,var(--green-2),var(--green-dark));
      box-shadow:0 10px 22px rgba(65,101,88,.20);
    }

    .btn-soft{
      flex:1;
      color:#31413a;
      background:rgba(255,255,255,.86);
      border:1px solid rgba(29,50,42,.07);
      box-shadow:var(--shadow-sm);
    }

    .month-nav{
      display:flex;
      gap:8px;
      overflow:auto;
      padding:2px 2px 8px;
      margin-bottom:12px;
      scroll-snap-type:x proximity;
      scrollbar-width:none;
    }
    .month-nav::-webkit-scrollbar{display:none}

    .month-chip{
      min-width:116px;
      flex:0 0 auto;
      scroll-snap-align:start;
      padding:10px 13px;
      border-radius:16px;
      color:#425149;
      background:rgba(255,255,255,.80);
      border:1px solid rgba(29,50,42,.07);
      box-shadow:var(--shadow-sm);
      font-size:.82rem;
    }

    .month-chip.active{
      color:#fff;
      border-color:transparent;
      background:linear-gradient(135deg,var(--green-2),var(--green-dark));
      box-shadow:0 12px 28px rgba(65,101,88,.18);
    }

    .panel{
      padding:15px;
      margin-bottom:12px;
      border-radius:26px;
      background:rgba(255,255,255,.72);
    }

    .layout{display:grid;grid-template-columns:1fr;gap:12px}

    .calendar-panel{
      touch-action:pan-y;
      min-width:0;
    }

    .swipe-hint{
      margin:0 0 11px;
      padding:7px 10px;
      text-align:center;
      color:#7a8881;
      background:rgba(239,245,242,.74);
      border:1px solid rgba(29,50,42,.06);
      border-radius:12px;
      font-size:.72rem;
    }

    .month-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
      margin-bottom:14px;
    }

    .season{
      display:inline-flex;
      padding:6px 10px;
      margin-bottom:6px;
      border-radius:999px;
      color:var(--green-dark);
      background:rgba(83,122,108,.08);
      font-size:.73rem;
      font-weight:730;
    }

    .month-title{
      margin:0;
      color:var(--green-dark);
      font-size:1.18rem;
      letter-spacing:-.025em;
      font-weight:850;
    }

    .calendar-grid{
      display:grid;
      grid-template-columns:repeat(7,minmax(0,1fr));
      gap:6px;
    }

    .weekday,.day{
      border:1px solid rgba(29,50,42,.07);
      border-radius:15px;
      background:rgba(255,255,255,.86);
    }

    .weekday{
      padding:8px 2px;
      text-align:center;
      color:#708078;
      background:rgba(241,246,244,.86);
      font-size:.62rem;
      font-weight:780;
    }

    .day{
      min-height:74px;
      padding:6px;
      display:flex;
      flex-direction:column;
      gap:6px;
      box-shadow:0 5px 14px rgba(31,55,46,.035);
      transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;
    }

    .day.empty{
      background:rgba(248,250,249,.48);
      border-style:dashed;
      box-shadow:none;
    }

    .day.has-events{cursor:pointer}
    .day.has-events:hover{
      transform:translateY(-2px);
      box-shadow:0 10px 20px rgba(31,55,46,.08);
      border-color:rgba(83,122,108,.14);
    }

    .day.dimmed{opacity:.38}

    .day-top{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:4px;
    }

    .day-number{
      width:26px;
      height:26px;
      display:inline-flex;
      justify-content:center;
      align-items:center;
      border-radius:10px;
      background:#f1f4f3;
      font-size:.72rem;
      font-weight:850;
    }

    .day-text{
      color:#68766f;
      font-size:.66rem;
      line-height:1.35;
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
    }

    .count{
      display:none;
      color:var(--muted);
      font-size:.67rem;
      font-weight:720;
    }

    .marker-row{
      margin-top:auto;
      display:flex;
      flex-wrap:wrap;
      gap:4px;
    }

    .marker{width:6px;height:6px}

    .panel-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
      margin-bottom:10px;
    }

    .panel-head h3,.panel-head h4{
      margin:0;
      color:var(--green-dark);
      font-size:.98rem;
      font-weight:850;
    }

    .muted{
      margin:0;
      color:var(--muted);
      font-size:.79rem;
      font-weight:650;
    }

    .events{display:grid;gap:9px}

    .event-card{
      position:relative;
      display:grid;
      gap:8px;
      padding:13px 13px 13px 16px;
      border-radius:18px;
      background:rgba(255,255,255,.90);
      border:1px solid rgba(29,50,42,.07);
      box-shadow:0 8px 18px rgba(31,55,46,.045);
      transition:transform .2s ease,box-shadow .2s ease;
      overflow:hidden;
    }

    .event-card::before{
      content:"";
      position:absolute;
      right:0;
      top:0;
      bottom:0;
      width:3px;
      background:linear-gradient(180deg,var(--green-2),var(--green-dark));
      opacity:.65;
    }

    .event-card:hover{
      transform:translateY(-2px);
      box-shadow:0 14px 26px rgba(31,55,46,.075);
    }

    .event-top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
      font-size:.78rem;
    }

    .tag{
      display:inline-flex;
      align-items:center;
      gap:7px;
      padding:6px 9px;
      border-radius:999px;
      background:rgba(245,248,247,.92);
      border:1px solid rgba(29,50,42,.06);
      color:#65736c;
      font-size:.68rem;
      font-weight:750;
    }

    .event-title{
      margin:0;
      color:#233029;
      line-height:1.55;
      font-size:.92rem;
      font-weight:820;
      letter-spacing:-.01em;
    }

    .summary{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:8px;
    }

    .summary-box{
      padding:12px;
      text-align:center;
      border-radius:17px;
      background:rgba(255,255,255,.86);
      border:1px solid rgba(29,50,42,.07);
      box-shadow:0 6px 16px rgba(31,55,46,.035);
    }

    .summary-box strong{
      display:block;
      margin-bottom:3px;
      color:var(--green-dark);
      font-size:1.08rem;
      font-weight:850;
    }

    .summary-box span{
      color:#6f7d76;
      font-size:.74rem;
      font-weight:650;
    }

    .month-view{display:none}
    .month-view.active{display:block}

    .year-view{
      display:none;
      grid-template-columns:1fr;
      gap:10px;
    }

    .year-view.active{display:grid}

    .mini-month{
      padding:13px;
      border-radius:22px;
    }

    .mini-month h3{
      margin:0 0 10px;
      color:var(--green-dark);
      font-size:.96rem;
      font-weight:850;
    }

    .mini-grid{
      display:grid;
      grid-template-columns:repeat(7,1fr);
      gap:5px;
    }

    .mini-head,.mini-day{
      padding:7px 0;
      text-align:center;
      border-radius:10px;
      font-size:.69rem;
    }

    .mini-head{
      color:#74837b;
      background:#f3f6f5;
      font-weight:720;
    }

    .mini-day{background:rgba(255,255,255,.88)}
    .mini-day.empty{background:rgba(248,250,249,.58)}

    .mini-day.eventful{
      color:var(--green-dark);
      background:var(--green-soft);
      font-weight:850;
      cursor:pointer;
    }

    .footer{
      margin-top:14px;
      padding:6px 8px 0;
      text-align:center;
      color:#89958f;
      font-size:.78rem;
      line-height:1.8;
    }

    .modal{
      position:fixed;
      inset:0;
      z-index:1000;
      display:none;
      align-items:flex-end;
      justify-content:center;
      padding:10px;
      background:rgba(20,31,27,.28);
      backdrop-filter:blur(8px);
      -webkit-backdrop-filter:blur(8px);
    }

    .modal.show{display:flex}

    .modal-card{
      width:min(520px,100%);
      max-height:82vh;
      overflow:auto;
      padding:16px;
      border-radius:28px 28px 18px 18px;
      background:rgba(255,255,255,.96);
      animation:fadeUp .22s ease;
    }

    .modal-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      margin-bottom:12px;
    }

    .modal-head h3{
      margin:0;
      color:var(--green-dark);
      font-size:1rem;
      font-weight:850;
    }

    .close-btn{
      width:38px;
      height:38px;
      padding:0;
      border-radius:50%;
      color:#43534b;
      background:#f1f5f3;
      font-size:1.1rem;
      line-height:1;
    }

    .empty-state{
      padding:16px;
      text-align:center;
      color:var(--muted);
      background:rgba(255,255,255,.82);
      border:1px dashed rgba(29,50,42,.12);
      border-radius:16px;
      font-size:.86rem;
    }

    #bottomNav{
      position:fixed;
      left:50%;
      bottom:12px;
      transform:translateX(-50%);
      width:min(520px,calc(100% - 20px));
      z-index:50;
    }

    .bottom-nav-wrap{
      display:flex;
      gap:7px;
      padding:7px;
      border-radius:24px;
      background:rgba(250,252,251,.80);
      border:1px solid rgba(255,255,255,.8);
      box-shadow:0 14px 36px rgba(31,55,46,.14);
      backdrop-filter:blur(24px) saturate(150%);
      -webkit-backdrop-filter:blur(24px) saturate(150%);
    }

    .nav-btn{
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:3px;
      padding:9px 8px;
      border-radius:17px;
    }

    .nav-btn small{
      font-size:.68rem;
      font-weight:700;
    }

    @media (min-width:700px){
      .container{width:min(1160px,calc(100% - 28px));margin-top:18px}
      .hero{padding:28px}
      .legend{gap:10px}
      .toolbar{grid-template-columns:minmax(260px,1fr) 210px auto auto}
      .month-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));overflow:visible}
      .month-chip{min-width:0}
      .layout{grid-template-columns:minmax(0,1.25fr) minmax(300px,.62fr);gap:14px}
      .calendar-grid{gap:8px}
      .weekday{font-size:.78rem;padding:9px 4px}
      .day{min-height:96px;padding:8px;border-radius:18px}
      .day-number{width:30px;height:30px;font-size:.82rem;border-radius:11px}
      .day-text{font-size:.74rem;-webkit-line-clamp:3}
      .count{display:block}
      .summary{grid-template-columns:repeat(2,minmax(0,1fr))}
      .year-view{grid-template-columns:repeat(2,minmax(0,1fr))}
      #bottomNav{width:min(620px,calc(100% - 28px))}
    }

    @media (min-width:1050px){
      .hero{
        display:grid;
        grid-template-columns:1.2fr .8fr;
        align-items:start;
        gap:18px;
      }
      .legend-box{margin-top:0}
      .month-nav{grid-template-columns:repeat(10,minmax(0,1fr))}
      .month-chip{font-size:.78rem;padding:10px 8px}
      .year-view{grid-template-columns:repeat(3,minmax(0,1fr))}
    }


    /* عرض الهاتف: التقويم يبقى أسبوعيًا لكن بمساحة فعلية لكل يوم */
    @media (max-width:699px){
      .container{width:calc(100% - 10px);margin-top:5px}
      .calendar-panel{
        overflow-x:auto;
        -webkit-overflow-scrolling:touch;
        overscroll-behavior-x:contain;
        scrollbar-width:thin;
      }
      .calendar-grid{
        min-width:790px;
        gap:7px;
        padding-bottom:6px;
      }
      .weekday{
        font-size:.73rem;
        padding:9px 4px;
      }
      .day{
        min-height:128px;
        padding:8px;
      }
      .day-number{
        width:29px;
        height:29px;
        font-size:.8rem;
      }
      .day-text{
        display:block;
        overflow:visible;
        -webkit-line-clamp:unset;
        -webkit-box-orient:initial;
        font-size:.76rem;
        line-height:1.48;
        white-space:normal;
        word-break:normal;
      }
      .count{display:block}
      .swipe-hint{
        position:sticky;
        right:0;
        left:0;
        z-index:4;
      }
      .event-title{
        font-size:.94rem;
        line-height:1.65;
      }
    }

    .day.search-hit{
      outline:3px solid rgba(83,122,108,.24);
      box-shadow:0 0 0 5px rgba(83,122,108,.08),0 14px 30px rgba(31,55,46,.10);
      transform:translateY(-2px);
    }

    .search-result-date{
      font-weight:800;
      color:var(--green-dark);
    }

    @media (prefers-reduced-motion:reduce){
      *{scroll-behavior:auto!important;animation:none!important;transition:none!important}
    }

    @media print{
      body{background:#fff}
      .toolbar,#bottomNav,.swipe-hint{display:none!important}
      .container{width:100%;margin:0;padding:0}
      .glass{box-shadow:none;backdrop-filter:none;background:#fff;border:1px solid #ddd}
      .month-nav{display:none}
    }
  </style>

</head>
<body>
  <div class="container">

    <header class="hero glass">
      <div class="top-row">
